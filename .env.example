BOT_TOKEN=
OWNER_ID=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_PROXY_URL=
# Keep openrouter active until the alternative key, endpoint and model are verified.
AI_PROVIDER=openrouter
ALTERNATE_API_KEY=
ALTERNATE_API_BASE_URL=
ALTERNATE_MODEL=claude-opus-5-5
DATABASE_URL=sqlite:///data/scout.db
SESSION_PATH=~/.local/share/freelance-ai-scout/telegram_user
DAILY_COST_LIMIT_USD=1.00
AI_CONCURRENCY=2
ALTERNATE_DRAFT_MODEL=
DISCOVERY_ENABLED=true
LOG_LEVEL=INFO
# Optional Mini App server; disabled by default. Keep the listener local on Mac.
MINIAPP_ENABLED=false
MINIAPP_HOST=127.0.0.1
MINIAPP_PORT=8080
# Public HTTPS origin without a path; required only for the Telegram menu button.
MINIAPP_URL=
